{
  "name": "training-job-queue",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "jest --runInBand --testPathIgnorePatterns='(integration|slow)\\.test\\.js'",
    "test:integration": "jest --runInBand --testMatch=**/*.integration.test.js --coverage --collectCoverageFrom=dist/queue.js --coverageReporters=text --coverageThreshold='{\"global\":{\"branches\":85,\"functions\":85,\"lines\":85,\"statements\":85}}'",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "migrate": "node dist/migrate.js",
    "chaos": "node scripts/chaos.cjs",
    "load": "node scripts/load.cjs",
    "chaos:mutation": "node scripts/mutation.cjs",
    "chaos:batch": "node scripts/chaos-batch.cjs",
    "test:chaos": "jest --runInBand --testMatch='**/*.slow.test.js'",
    "test:clock": "node scripts/clock.cjs",
    "test:isolation": "node scripts/isolation.cjs"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "pg": "^8.23.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.23.1",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  },
  "overrides": {
    "light-my-request": "6.6.0"
  }
}
